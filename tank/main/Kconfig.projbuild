menu "Tank Config"

    config TANK_WIFI_SSID
        string "Wi-Fi SSID"
        default "iot-tank-arena"

    config TANK_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config TANK_SERVER_HOST
        string "Server host and port"
        default "192.168.2.1:8000"

    config TANK_ID
        int "Tank ID"
        range 1 2
        default 1

endmenu
